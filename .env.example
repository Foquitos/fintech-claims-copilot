# Copy to .env. Without credentials, agent-api uses the offline lexical embedder.

# Option A: Azure OpenAI (OpenAI-compatible v1 endpoint). Model names are deployment names.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Option B: OpenAI directly (used when AZURE_OPENAI_ENDPOINT is empty).
OPENAI_API_KEY=

LLM_MODEL=gpt-4.1-mini
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small
